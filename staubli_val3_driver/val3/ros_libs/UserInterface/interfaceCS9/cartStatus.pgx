<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="cartStatus" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nCartConnFlag" type="num" xsi:type="element" />
      <Parameter name="x_nLastMsgAge" type="num" xsi:type="element" />
    </Parameters>
    <Code><![CDATA[begin
  
  // update cartesian status on port 11001

  switch x_nCartConnFlag
    case -1
      userPageSet("uxMonitor", "lblCartState", "innerHTML", "connection lost")
    break
    case 0
      userPageSet("uxMonitor", "lblCartState", "innerHTML", "not connected")
    break
    case 1
      userPageSet("uxMonitor", "lblCartState", "innerHTML", "connected")
    break
    default
      userPageSet("uxMonitor", "lblCartState", "innerHTML", "not connected")
    break
  endSwitch

  if (x_nLastMsgAge < 0)
    userPageSet("uxMonitor", "lblCartAge", "innerHTML", "last msg: n/a")
  else
    userPageSet("uxMonitor", "lblCartAge", "innerHTML", "last msg: " + toString(".1", x_nLastMsgAge) + " s")
  endIf
  
end]]></Code>
  </Program>
</Programs>
