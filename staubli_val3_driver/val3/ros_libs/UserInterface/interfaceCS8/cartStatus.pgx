<?xml version="1.0" encoding="utf-8"?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2">
  <Program name="cartStatus" access="public">
    <Parameters xmlns="http://www.staubli.com/robotics/VAL3/Param/1">
      <Parameter name="x_nCartConnFlag" type="num" xsi:type="element" />
      <Parameter name="x_nLastMsgAge" type="num" xsi:type="element" />
    </Parameters>
    <Code><![CDATA[begin
  
  // update connection status on port 11001 (cartesian server)
  
  gotoxy(scMonitor, 0,1)
  put(scMonitor, "Port 11001:")
  gotoxy(scMonitor, 12,1)
  switch x_nCartConnFlag
    case -1
      put(scMonitor, "connection lost")
    break
    case 0
      put(scMonitor, "not connected")
    break
    case 1
      put(scMonitor, "connected")
    break
    default
      put(scMonitor, "not connected")
    break
  endSwitch

  gotoxy(scMonitor, 0,2)
  put(scMonitor, "Last cart msg:")
  gotoxy(scMonitor, 14,2)
  if (x_nLastMsgAge < 0)
    put(scMonitor, "n/a")
  else
    put(scMonitor, toString(".1", x_nLastMsgAge) + " s")
  endIf
  
end]]></Code>
  </Program>
</Programs>
